# 2.5 YouTube player: the helper DLL may import only system DLLs (design2.md 3.2). Run after every link of
# tsmedia_player: cmake -DDUMPBIN=<dumpbin.exe> -DDLL=<the helper> -P check_player_imports.cmake
# Anything else fails the build (a DLL missing on a user's PC would make every Play open the browser).
if(NOT EXISTS "${DUMPBIN}")
    message(FATAL_ERROR "check_player_imports: dumpbin.exe not found at ${DUMPBIN}")
endif()
execute_process(COMMAND "${DUMPBIN}" /nologo /imports "${DLL}" OUTPUT_VARIABLE dump RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "check_player_imports: dumpbin failed on ${DLL}")
endif()
set(allowed kernel32.dll user32.dll gdi32.dll ole32.dll oleaut32.dll advapi32.dll shlwapi.dll version.dll shell32.dll)
string(REPLACE "\n" ";" lines "${dump}")
set(found "")
foreach(line IN LISTS lines)
    if(line MATCHES "^    ([A-Za-z0-9_.-]+[.][dD][lL][lL])[ \r]*$")
        string(TOLOWER "${CMAKE_MATCH_1}" module)
        list(APPEND found "${module}")
        if(NOT module MATCHES "^api-ms-win-")
            list(FIND allowed "${module}" index)
            if(index EQUAL -1)
                message(FATAL_ERROR "The player helper ${DLL} imports ${module}, which is not on its allowlist (cmake/check_player_imports.cmake).")
            endif()
        endif()
    endif()
endforeach()
if(NOT found)
    message(FATAL_ERROR "check_player_imports: no imports read from ${DLL}")
endif()
list(REMOVE_DUPLICATES found)
string(REPLACE ";" " " found "${found}")
message(STATUS "Player helper imports (allowed): ${found}")
